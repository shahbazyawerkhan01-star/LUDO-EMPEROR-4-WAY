{
    "name": "ludo-emperor-4-way",
    "version": "1.0.0",
    "description": "Ludo Emperor 4 Way - 2-dice Ludo with Lucky Seven, 3D tilted board (Pixi.js + React + RUN.game)",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "_build": "tsc --noEmit && vite build",
        "build": "npm run _build",
        "build:bundled": "cross-env RUNDOT_GAME_DISABLE_EMBEDDED_LIBS=true npm run _build",
        "preview": "vite preview",
        "deploy": "npm run build && rundot deploy"
    },
    "keywords": [
        "pixi",
        "react",
        "tailwind",
        "vite",
        "typescript",
        "game"
    ],
    "license": "SEE LICENSE IN LICENSE.txt",
    "allowScripts": {
        "@firebase/util": true,
        "@series-inc/rundot-game-sdk": true,
        "esbuild": true,
        "fsevents": true,
        "protobufjs": true
    },
    "dependencies": {
        "@series-inc/rundot-game-sdk": "5.28.1",
        "pixi.js": "8.19.0",
        "react": "19.2.4",
        "react-dom": "19.2.4"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.4.1",
        "cross-env": "^7.0.3",
        "firebase": "^12.16.0",
        "tailwindcss": "^4.1.5",
        "typescript": "^5.8.0",
        "vite": "^6.3.5",
        "vite-plugin-singlefile": "^2.3.3"
    }
}
